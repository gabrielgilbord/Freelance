# URL pública definitiva (sin barra final). Se usa en canonical, sitemap, Open Graph y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com

# Email público de contacto (se muestra en la web). Déjalo vacío para ocultarlo.
NEXT_PUBLIC_CONTACT_EMAIL=

# Entrega del formulario de contacto: "smtp" | "resend" | "webhook" | "console"
CONTACT_PROVIDER=console

# --- SMTP de Google (CONTACT_PROVIDER=smtp, y también las invitaciones del panel) ---
# Contraseña de aplicación de Gmail, no la contraseña normal de la cuenta.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Cota
# Dirección pública para enlaces en los correos del panel (sin barra final)
PANEL_URL=

# Aviso diario de facturación (Vercel Cron). Debe coincidir con private.app_secrets 'cron' en Supabase.
CRON_SECRET=

# --- Resend (CONTACT_PROVIDER=resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Cota <web@tu-dominio.com>

# --- Webhook genérico: n8n, Make, Zapier, Slack... (CONTACT_PROVIDER=webhook) ---
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Muestra el manual de marca interno en /marca también en producción (por defecto oculto)
SHOW_BRAND_PAGE=false
